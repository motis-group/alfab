# Copy to .env (the server) or .env.local (this machine) and fill in the blanks.
# Both are gitignored. Never commit a filled-in copy, and never paste a secret into a chat window.

# --- Required ---

# Postgres. postgresql://user:password@host:5432/database
DATABASE_URL=

# The password that signs in the bootstrap superadmin. Sign-in is refused while this is blank.
ADMIN_PASSWORD=

# Where the app is served from, used in links it sends out.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Reading a customer's order (PDF and Word) ---

# Without this, /glass/quote says the feature is not switched on and the panel is the only thing
# affected. See projects/costing/development/specs/order-import.md.
ANTHROPIC_API_KEY=

# --- Optional ---

# Username for the bootstrap superadmin. Defaults to "superadmin".
SUPERADMIN_USERNAME=

# TLS to the database. Set DATABASE_SSL=true for a managed instance such as RDS.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=

# LibreDWG's dwg2dxf, when it is not on PATH. See specs/cad-import.md.
CAD_DWG2DXF_PATH=

# --- Billing (only needed when Stripe is in use) ---

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ACCOUNT_KEY=
BILLING_COMPANY_NAME=
BILLING_DEFAULT_EMAIL=
BILLING_MARGIN_PERCENT=
BILLING_MONTHLY_HOURS=
BILLING_MISC_BUFFER_AUD=
BILLING_EC2_HOURLY_AUD=
BILLING_EC2_STORAGE_GB=
BILLING_EC2_STORAGE_GB_MONTH_AUD=
BILLING_RDS_HOURLY_AUD=
BILLING_RDS_STORAGE_GB=
BILLING_RDS_STORAGE_GB_MONTH_AUD=
